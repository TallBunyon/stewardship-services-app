{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowJs": true,
    "checkJs": false,
    "paths": {
      "@netlify/functions": ["./node_modules/@netlify/functions"]
    }
  },
  "include": ["./**/*.ts", "../netlify/functions/*.ts", "../netlify/lib/*.ts"],
  "exclude": ["node_modules"]
}
