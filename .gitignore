# Local Netlify folder
.netlify
node_modules/
dist/
.env

# Secrets and local env files (never commit real values)
.dev.vars
.env*
# Keep the placeholder template tracked (it is matched by .env* above)
!.env.example

# Wrangler local state (local D1 copies can hold real lead data)
.wrangler/

# Data exports / dumps / downloaded leads (customer data)
dumps/
exports/
leads/
*.sql
# ...but keep Worker D1 schema migrations tracked
!workers/*/migrations/*.sql
# ...and keep the app's existing SQL folders (Supabase migrations, seeds) tracked,
# so a hotfix migration during the freeze is never silently ignored (COO fix 2026-10-17).
!supabase/**/*.sql
!netlify/supabase/*.sql
