# AI (OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here

# Database (Supabase)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Email notifications (Resend)
RESEND_API_KEY=re_your_resend_key_here
NOTIFY_EMAIL=you@example.com

# Lead storage switch: supabase (default, unchanged behaviour) | dual | worker
LEADS_BACKEND=supabase

# Cloudflare Worker lead API (workers/leads-api); read only when LEADS_BACKEND is dual or worker
LEADS_API_URL=https://services-leads-api.your-subdomain.workers.dev
LEADS_API_SECRET=your_leads_api_secret_here
